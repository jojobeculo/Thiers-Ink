# Copier ce fichier en .env (jamais versionné) et renseigner les valeurs.

# --- Build ------------------------------------------------------------------
# Domaine définitif, en HTTPS, sans barre finale. Active l'URL canonique, les URL
# absolues Open Graph, le sitemap et sa mention dans robots.txt.
SITE_URL=

# Sous-chemin de déploiement, vide à la racine du domaine (ex. /Thiers-Ink pour
# l'aperçu GitHub Pages).
BASE_PATH=

# true pour un hébergement sans serveur (aperçu GitHub Pages) : le formulaire
# affiche que l'envoi en ligne n'est pas actif.
PUBLIC_STATIC_PREVIEW=false

# Identifiant de mesure Google Analytics 4 (format G-XXXXXXXXXX). Lu au build.
# Vide : aucun outil de mesure, aucun bandeau de consentement affiché.
PUBLIC_GA_MEASUREMENT_ID=

# --- Exécution (serveur) ----------------------------------------------------
PORT=4321
HOST=0.0.0.0
# true derrière un proxy HTTPS : redirection HTTP → HTTPS et en-tête HSTS.
FORCE_HTTPS=false

# Envoi des demandes de rendez-vous par SMTP. Secrets : côté serveur uniquement.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Destinataire des demandes (par défaut : l'adresse publique du salon).
BOOKING_TO=
# Adresse expéditrice (par défaut : SMTP_USER). Obligatoire si SMTP_USER n'est pas une
# adresse e-mail. Doit être autorisée par le serveur SMTP (sinon l'envoi échoue).
BOOKING_FROM=

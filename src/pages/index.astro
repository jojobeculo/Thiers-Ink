---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Atelier from '../components/Atelier.astro';
import Marquee from '../components/Marquee.astro';
import Portfolio from '../components/Portfolio.astro';
import Services from '../components/Services.astro';
import Artist from '../components/Artist.astro';
import Reviews from '../components/Reviews.astro';
import Instagram from '../components/Instagram.astro';
import Practical from '../components/Practical.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { faqJsonLd } from '../lib/seo';
import { publishedFaq } from '../data/faq';

// Le salon et le site sont ajoutés par BaseLayout ; la page y joint sa FAQ.
const jsonLd = [faqJsonLd(publishedFaq.filter((f) => !f.draft))];
---

<BaseLayout title={`Salon de tatouage et piercing à Thiers (63) | ${site.name}`} jsonLd={jsonLd}>
  <div class="hero-stack">
    <Hero />
    <Atelier />
  </div>
  <Marquee label="L'atelier" items={['Tatouage', 'Piercing', 'Thiers', 'Puy-de-Dôme', 'Rue des Docteurs-Dumas']} />
  <Portfolio />
  <CtaBand
    id="cta-projet"
    kicker="Tatouage & piercing à Thiers"
    lines={['Un projet', 'en tête ?']}
    text="Décrivez votre idée en quelques lignes : le salon vous répond pour convenir d'un rendez-vous."
  />
  <Services />
  <Artist />
  <Reviews />
  <Instagram />
  <Practical />
  <Faq />
  <Booking />
</BaseLayout>

---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import dotwork from '../assets/images/etudes/dotwork.jpg';
import { site } from '../config/site';
---

<ServiceLayout
  path="/piercing-thiers"
  name="Piercing"
  title={`Piercing à Thiers (63) — oreille, nez, corps | ${site.name}`}
  description={`Piercing à Thiers (63) chez ${site.name}, 43 rue des Docteurs-Dumas : oreille, nez et piercing corporel. Rendez-vous en ligne ou au ${site.phone.display}.`}
  heading={['Piercing', 'à Thiers']}
  lead={`Vous cherchez où faire un piercing à ${site.address.city} ? ${site.name} réalise des piercings au ${site.address.street}, à ${site.address.city} (Puy-de-Dôme) : piercing de l’oreille, du nez et piercing corporel.`}
  aboutHeading={['Votre piercing', 'à Thiers']}
  about={[
    `Piercing de l'oreille, du nez ou piercing corporel : ${site.name} réalise vos piercings au ${site.address.street}, à ${site.address.city}.`,
    'Pour une première fois comme pour compléter vos piercings, indiquez la zone souhaitée et posez vos questions : le salon vous répond pour convenir d’un rendez-vous.',
  ]}
  items={['Oreille', 'Nez', 'Corps']}
  steps={[
    {
      title: 'Indiquez la zone',
      text: 'Avec le formulaire de rendez-vous ou par téléphone : la zone à percer et, si vous le souhaitez, une photo de référence.',
    },
    {
      title: 'Posez vos questions',
      text: 'Une première fois, un piercing particulier : précisez-le dans votre message pour en parler avec le salon.',
    },
    {
      title: 'Convenez d’un rendez-vous',
      text: 'Le salon vous répond par e-mail ou par téléphone pour fixer une date.',
    },
  ]}
  tips={[
    {
      title: 'Choisissez l’emplacement',
      text: 'Oreille, nez ou autre zone du corps : indiquez-la précisément dans votre demande.',
    },
    {
      title: 'Montrez une référence',
      text: 'Une photo d’un piercing qui vous plaît aide à décrire le placement souhaité.',
    },
    {
      title: 'Notez vos questions',
      text: 'Le rendez-vous est le bon moment pour poser toutes les questions sur le piercing envisagé.',
    },
  ]}
  faqIds={['piercing-thiers', 'rendez-vous', 'reference', 'horaires', 'adresse']}
  image={dotwork}
  imageAlt="Visuel provisoire pour la page piercing à Thiers : mandala en pointillé beige sur fond noir."
  related={{ label: 'Tatoueur à Thiers', path: '/tatoueur-thiers' }}
/>

---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import encre01 from '../assets/images/etudes/encre-01.jpg';
import { site } from '../config/site';
---

<ServiceLayout
  path="/tatoueur-thiers"
  name="Tatoueur"
  serviceType="Tatouage"
  title={`Tatoueur à Thiers (63) — salon de tatouage ${site.name}`}
  description={`Tatoueur à Thiers (63) : salon de tatouage ${site.name}, 43 rue des Docteurs-Dumas. Décrivez votre projet et prenez rendez-vous en ligne ou au ${site.phone.display}.`}
  heading={['Tatoueur', 'à Thiers']}
  lead={`Vous cherchez un tatoueur à ${site.address.city} ? ${site.name} est un salon de tatouage situé au ${site.address.street}, à ${site.address.city} (Puy-de-Dôme). Chaque projet se prépare à partir de votre demande : le motif, son emplacement, la taille envisagée et le style recherché.`}
  aboutHeading={['Votre tatoueur', 'à Thiers']}
  about={[
    `${site.name} est le salon de tatouage et de piercing d'${site.owner.name}, installé au ${site.address.street}, à ${site.address.city}, dans le Puy-de-Dôme.`,
    'Premier tatouage ou nouvelle pièce, petit motif ou projet plus grand : décrivez votre idée, joignez une image de référence si vous en avez une, et le salon vous répond pour en parler et fixer un rendez-vous.',
  ]}
  items={['Projet personnel', 'Motif', 'Emplacement', 'Taille', 'Style']}
  steps={[
    {
      title: 'Décrivez votre projet',
      text: 'Avec le formulaire de rendez-vous ou par téléphone : le motif, l’emplacement sur le corps, la taille approximative et le style souhaité.',
    },
    {
      title: 'Joignez une image de référence',
      text: 'Facultatif : une image JPG, PNG, WebP ou HEIC de 5 Mo au maximum, pour illustrer votre idée.',
    },
    {
      title: 'Convenez d’un rendez-vous',
      text: 'Le salon vous répond par e-mail ou par téléphone pour échanger sur le projet et fixer une date.',
    },
  ]}
  tips={[
    {
      title: 'Rassemblez vos références',
      text: 'Photos, dessins, captures : quelques images suffisent pour montrer l’esprit du motif que vous imaginez.',
    },
    {
      title: 'Pensez à l’emplacement',
      text: 'La zone du corps influence la taille et la lisibilité du motif. Indiquez-la dès votre demande.',
    },
    {
      title: 'Estimez la taille',
      text: 'Une dimension approximative en centimètres aide à préparer l’échange avec le salon.',
    },
    {
      title: 'Précisez vos contraintes',
      text: 'Une date importante, une première fois, une question particulière : notez-le dans votre message.',
    },
  ]}
  faqIds={['tatoueur-thiers', 'rendez-vous', 'preparer', 'reference', 'horaires', 'realisations']}
  image={encre01}
  imageAlt="Visuel provisoire d'encre pour la page tatoueur à Thiers : volutes claires sur fond noir."
  related={{ label: 'Piercing à Thiers', path: '/piercing-thiers' }}
/>

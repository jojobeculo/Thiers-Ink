---
import { getImage } from 'astro:assets';
import BookingButton from './BookingButton.astro';
import { site } from '../config/site';
import landscape from '../assets/images/hero/goutte-encre-paysage.jpg';
import portrait from '../assets/images/hero/goutte-encre-portrait.jpg';

// Image fixe tirée du shader (même scène, t = 6 s) : image LCP, repli du mode
// réduit et des navigateurs sans WebGL. Cadrage différent en portrait.
const sources = await Promise.all(
  [
    { img: portrait, media: '(orientation: portrait)', widths: [540, 810, 1080] },
    { img: landscape, media: undefined, widths: [960, 1440, 1920, 2560] },
  ].flatMap(({ img, media, widths }) =>
    (['avif', 'webp'] as const).map(async (format) => {
      const result = await getImage({ src: img, widths, format, quality: 72 });
      return { media, type: `image/${format}`, srcset: result.srcSet.attribute };
    }),
  ),
);
const fallback = await getImage({ src: landscape, width: 1920, format: 'jpg', quality: 78 });
const letters = site.name.split('');
---

<section class="hero grain" id="top" data-hero data-surface="dark" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <picture class="hero__poster">
      {sources.map((s) => <source media={s.media} type={s.type} srcset={s.srcset} sizes="100vw" />)}
      <img
        src={fallback.src}
        width={landscape.width}
        height={landscape.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__shade"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__lead">
      <p class="hero__intro t-body-lg">
        Atelier de tatouage et de piercing au {site.address.street}, à {site.address.city}.
      </p>
      <BookingButton class="hero__cta" />
    </div>

    <div class="hero__bottom">
      <div class="hero__meta t-caption">
        <span><span class="hero__meta-dot" aria-hidden="true"></span>Tatouage &amp; piercing</span>
        <span class="hero__meta-mid">N° 43 — Rue des Docteurs-Dumas</span>
        <span>{site.address.city} — {site.address.region}</span>
      </div>
      <h1 class="hero__title" id="hero-title">
        <span class="sr-only">{site.name}, tatouage et piercing à {site.address.city}</span>
        <span class="hero__wordmark" aria-hidden="true">
          {letters.map((ch, i) => <span class="hero__char" style={`--ci:${i}`}>{ch}</span>)}
        </span>
      </h1>
    </div>

    <a class="hero__scroll t-caption" href="#atelier">
      <span class="hero__scroll-line" aria-hidden="true"></span>
      Découvrir l'atelier
    </a>
  </div>
</section>

<script>
  import { getTier } from '../scripts/motion';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  let renderer: { destroy: () => void } | null = null;
  let loading = false;

  // WebGL uniquement au niveau full, chargé après le premier rendu.
  async function sync() {
    const tier = getTier();
    if (tier !== 'full') {
      renderer?.destroy();
      renderer = null;
      return;
    }
    if (renderer || loading || !canvas) return;
    loading = true;
    try {
      const { createInkRenderer } = await import('../scripts/hero/renderer');
      if (getTier() === 'full') renderer = createInkRenderer(canvas);
    } finally {
      loading = false;
    }
  }

  const start = () => ('requestIdleCallback' in window ? requestIdleCallback(sync, { timeout: 1200 }) : setTimeout(sync, 300));
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start, { once: true });
  window.addEventListener('thiersink:motion', sync);
</script>

<style>
  .hero {
    --cover: 0;
    position: relative;
    z-index: 0;
    min-height: max(100svh, 560px);
    overflow: hidden;
    color: var(--color-parchment);
  }

  /* Plan collé : la section suivante glisse par-dessus le hero. */
  @media (min-height: 600px) {
    .hero {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__poster,
  .hero__poster img,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster img {
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero__canvas {
    opacity: 0;
    transition: opacity 1.4s var(--ease-editorial);
  }

  .hero__canvas[data-ready] {
    opacity: 1;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(16 15 14 / 0.55), transparent 28%),
      linear-gradient(to top, rgb(16 15 14 / 0.7), transparent 45%);
    opacity: calc(1 + var(--cover) * 0.6);
  }

  .hero__shade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-soot);
    opacity: calc(var(--cover) * 0.75);
  }

  .hero__inner {
    position: relative;
    width: var(--container);
    margin-inline: auto;
    min-height: inherit;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: calc(var(--header-h) + clamp(28px, 7vh, 96px));
    padding-bottom: clamp(18px, 3.5vh, 36px);
    transform: translate3d(0, calc(var(--cover) * -6vh), 0) scale(calc(1 - var(--cover) * 0.05));
    transform-origin: 50% 100%;
  }

  .hero__lead {
    align-self: start;
    max-width: 30rem;
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .hero__intro {
    max-width: 24ch;
    color: var(--color-parchment);
  }

  .hero__bottom {
    display: grid;
    gap: clamp(14px, 2vh, 22px);
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid rgb(216 203 184 / 0.32);
    color: var(--color-parchment);
  }

  .hero__meta-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--color-saffron-glow);
    vertical-align: 0.1em;
  }

  .hero__title {
    margin-bottom: -0.06em;
    container-type: inline-size;
  }

  .hero__wordmark {
    display: flex;
    justify-content: space-between;
    overflow: hidden;
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    font-size: var(--fs-wordmark);
    font-size: calc(100cqi / var(--wordmark-ratio));
    line-height: 0.8;
    letter-spacing: -0.016em;
    padding-top: 0.04em;
    padding-bottom: 0.02em;
  }

  .hero__char {
    display: inline-block;
  }

  .hero__scroll {
    position: absolute;
    right: 0;
    top: calc(var(--header-h) + clamp(28px, 7vh, 96px));
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    writing-mode: vertical-rl;
    text-decoration: none;
    color: var(--color-parchment);
    min-width: 44px;
    padding-block: 6px;
  }

  .hero__scroll-line {
    width: 1px;
    height: 64px;
    background: rgb(216 203 184 / 0.3);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-saffron-glow);
    transform: translateY(-100%);
  }

  /* Chorégraphie d'ouverture (CSS seul, n'empêche aucune interaction) */
  :global(html.js[data-motion='full']) .hero__char,
  :global(html.js[data-motion='lite']) .hero__char {
    animation: char-in 1.3s var(--ease-out-expo) both;
    animation-delay: calc(0.1s + var(--ci) * 0.055s);
  }

  :global(html.js[data-motion='full']) .hero__meta,
  :global(html.js[data-motion='lite']) .hero__meta,
  :global(html.js[data-motion='full']) .hero__lead > *,
  :global(html.js[data-motion='lite']) .hero__lead > * {
    animation: rise-in 1.1s var(--ease-out-expo) both;
    animation-delay: 0.55s;
  }

  :global(html.js[data-motion='full']) .hero__lead > :nth-child(2),
  :global(html.js[data-motion='lite']) .hero__lead > :nth-child(2) {
    animation-delay: 0.68s;
  }

  :global(html.js[data-motion='full']) .hero__scroll-line::after {
    animation: scroll-cue 2.6s var(--ease-in-out) 1.6s infinite;
  }

  @keyframes char-in {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
  }

  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 720px) {
    .hero__meta-mid {
      display: none;
    }
    .hero__scroll {
      display: none;
    }
    .hero__poster img {
      object-position: 50% 50%;
    }
  }

  @media (max-width: 420px) {
    .hero__meta {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>

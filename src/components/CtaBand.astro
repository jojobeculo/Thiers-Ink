---
import { Picture } from 'astro:assets';
import SplitHeading from './SplitHeading.astro';
import BookingButton from './BookingButton.astro';
import CallButton from './CallButton.astro';
import encre01 from '../assets/images/etudes/encre-01.jpg';

interface Props {
  id: string;
  kicker: string;
  lines: string[];
  text: string;
}

const { id, kicker, lines, text } = Astro.props;
---

<section class="cta-band grain" data-surface="dark" aria-labelledby={id}>
  <div class="cta-band__bg" aria-hidden="true">
    <Picture src={encre01} alt="" widths={[800, 1400, 2000]} sizes="100vw" formats={['avif', 'webp']} quality={60} loading="lazy" />
  </div>
  <div class="container cta-band__inner">
    <p class="t-caption cta-band__kicker" data-reveal="fade"><span class="cta-band__dot" aria-hidden="true"></span>{kicker}</p>
    <SplitHeading id={id} class="t-display cta-band__title" lines={lines} />
    <p class="t-body-lg cta-band__text" data-reveal="fade" style="--i:1">{text}</p>
    <div class="cta-band__actions" data-reveal="fade" style="--i:2">
      <BookingButton size="lg" />
      <CallButton />
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: clamp(96px, 12vw, 180px);
    border-block: 1px solid var(--color-graphite);
  }

  .cta-band__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.38;
  }

  .cta-band__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-band__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-soot) 15%, transparent 85%);
  }

  :global(html[data-motion='full']) .cta-band__bg :global(img),
  :global(html[data-motion='lite']) .cta-band__bg :global(img) {
    animation: cta-drift 26s var(--ease-in-out) infinite alternate;
  }

  @keyframes cta-drift {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1.18) translate3d(-3%, 2%, 0);
    }
  }

  .cta-band__inner {
    display: grid;
    gap: clamp(20px, 2.5vw, 32px);
    justify-items: start;
  }

  .cta-band__kicker {
    color: var(--accent);
  }

  .cta-band__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.1em;
  }

  .cta-band__text {
    max-width: 34ch;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  @media (max-width: 560px) {
    .cta-band__actions,
    .cta-band__actions > :global(*) {
      width: 100%;
    }
  }
</style>

---
import { bookingHref, isExternalBooking } from '../config/site';

interface Props {
  class?: string;
  size?: 'md' | 'sm';
}

const { class: className, size = 'md' } = Astro.props;
---

<a
  class:list={['btn', 'btn--cta', size === 'sm' && 'btn--sm', className]}
  href={bookingHref}
  data-cursor="link"
  {...isExternalBooking ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span class="btn__dot" aria-hidden="true"></span>
  <span>Prendre rendez-vous</span>
  {isExternalBooking && <span class="sr-only">(nouvel onglet)</span>}
  <svg class="btn__arrow" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
    <path d="M1 7h11M8 3l4 4-4 4"></path>
  </svg>
</a>

<style>
  .btn--sm {
    min-height: 44px;
    padding: 12px 18px;
    font-size: 13px;
    gap: 10px;
  }
</style>

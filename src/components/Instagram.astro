---
import ExternalIcon from './ExternalIcon.astro';
import BookingButton from './BookingButton.astro';
import { site } from '../config/site';

const handle = site.social.instagram.handle;
---

<section class="insta grain" data-surface="dark" aria-labelledby="insta-title">
  <div class="container insta__inner">
    <div class="section-meta t-caption">
      <span><span class="section-meta__index">06</span> — Instagram</span>
      <span>Publications de l'atelier</span>
    </div>
    <h2 class="sr-only" id="insta-title">Instagram</h2>
    <a class="insta__link" href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" data-cursor="link">
      <span class="insta__handle" data-reveal="lines">
        <span class="split-line"><span class="split-inner">{handle}</span></span>
      </span>
      <span class="insta__cta t-ui">
        Suivre l'atelier sur Instagram<span class="sr-only"> (nouvel onglet)</span>
        <ExternalIcon />
      </span>
    </a>
    <div class="insta__actions" data-reveal="fade">
      <p class="t-muted">Un motif repéré sur Instagram ? Joignez-le à votre demande.</p>
      <BookingButton />
    </div>
  </div>
</section>

<style>
  .insta {
    position: relative;
    z-index: 1;
    padding-block: clamp(72px, 9vw, 140px);
  }

  .insta__link {
    display: grid;
    gap: 24px;
    margin-top: clamp(32px, 5vw, 64px);
    text-decoration: none;
  }

  .insta__handle {
    display: block;
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: clamp(2.4rem, 0.6rem + 7.6vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
    transition: color 0.6s var(--ease-editorial);
  }

  .insta__link:hover .insta__handle,
  .insta__link:focus-visible .insta__handle {
    color: var(--accent);
  }

  .insta__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    padding-bottom: 4px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }

  .insta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .insta__link:hover :global(.ext-icon) {
    transform: translate(3px, -3px);
  }
</style>

---
import ExternalIcon from './ExternalIcon.astro';
import BookingButton from './BookingButton.astro';
import CallButton from './CallButton.astro';
import { site, mapLinks, withBase } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer grain" data-surface="dark">
  <div class="container">
    <div class="footer__cta">
      <p class="footer__cta-title">Un projet de tatouage ou de piercing à {site.address.city} ?</p>
      <div class="footer__cta-actions">
        <BookingButton />
        <CallButton />
      </div>
    </div>

    <div class="footer__grid">
      <div class="footer__col">
        <p class="t-caption footer__label">Salon</p>
        <address>
          {site.name}<br />
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}, {site.address.region}
        </address>
        {
          site.hours.length > 0 && (
            <ul class="footer__hours" role="list">
              {site.hours.map((h) => (
                <li>
                  <span>{h.days}</span> <span>{h.hours}</span>
                </li>
              ))}
            </ul>
          )
        }
        <a class="link t-caption" href={mapLinks.google} target="_blank" rel="noopener noreferrer">
          Itinéraire<span class="sr-only"> (Google Maps, nouvel onglet)</span>
          <ExternalIcon />
        </a>
      </div>
      <div class="footer__col">
        <p class="t-caption footer__label">Contact</p>
        <a class="link link--quiet" href={site.phone.href}>{site.phone.display}</a>
        <a class="link link--quiet footer__mail" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link link--quiet" href={site.social.instagram.url} target="_blank" rel="noopener noreferrer">
          Instagram<span class="sr-only"> (nouvel onglet)</span><ExternalIcon />
        </a>
        <a class="link link--quiet" href={site.social.facebook} target="_blank" rel="noopener noreferrer">
          Facebook<span class="sr-only"> (nouvel onglet)</span><ExternalIcon />
        </a>
      </div>
      <nav class="footer__col" aria-label="Prestations">
        <p class="t-caption footer__label">Prestations</p>
        <a class="link link--quiet" href={withBase('/tatouage-thiers')}>Tatouage à Thiers</a>
        <a class="link link--quiet" href={withBase('/piercing-thiers')}>Piercing à Thiers</a>
        <a class="link link--quiet" href={withBase('/#portfolio')}>Portfolio</a>
        <a class="link link--quiet" href={withBase('/#faq')}>Questions fréquentes</a>
        <a class="link link--quiet" href={withBase('/#rendez-vous')}>Demande de rendez-vous</a>
      </nav>
      <nav class="footer__col" aria-label="Informations légales">
        <p class="t-caption footer__label">Informations</p>
        <a class="link link--quiet" href={withBase('/mentions-legales')}>Mentions légales</a>
        <a class="link link--quiet" href={withBase('/confidentialite')}>Confidentialité</a>
        <a class="link link--quiet" href={withBase('/cgu')}>Conditions d'utilisation</a>
        <button class="link link--quiet footer__btn" type="button" data-consent-open>Préférences cookies</button>
        <button class="link link--quiet footer__btn" type="button" data-motion-toggle>
          <span data-motion-label>Réduire les animations</span>
        </button>
      </nav>
    </div>

    <div class="footer__mark" aria-hidden="true">
      <p class="footer__wordmark" data-reveal="chars">
        <span class="split-line">
          {site.name.split('').map((ch, i) => <span class="split-char" style={`--ci:${i}`}>{ch}</span>)}
        </span>
      </p>
    </div>

    <div class="footer__bottom t-caption">
      <span>© {year} {site.name} — {site.activity}</span>
      <span>{site.address.city}, {site.address.region}</span>
      <a class="link link--quiet" href="#top">Haut de page ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: 24px;
    border-top: 1px solid var(--color-graphite);
    overflow: hidden;
  }

  .footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding-bottom: clamp(40px, 5vw, 64px);
    margin-bottom: clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--color-graphite);
  }

  .footer__cta-title {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: var(--fs-subheading);
    line-height: 1;
    letter-spacing: var(--tracking-heading-em);
    text-transform: uppercase;
    max-width: 22ch;
  }

  .footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer__hours {
    display: grid;
    gap: 2px;
    margin: 6px 0 4px;
    padding: 0;
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px var(--gap);
  }

  .footer__col {
    display: grid;
    gap: 8px;
    align-content: start;
    justify-items: start;
  }

  .footer__col address {
    font-style: normal;
  }

  .footer__label {
    color: var(--fg-muted);
    margin-bottom: 6px;
  }

  .footer__mail {
    overflow-wrap: anywhere;
  }

  .footer__btn {
    border: 0;
    padding-inline: 0;
    background-color: transparent;
    text-align: left;
    min-height: 32px;
  }

  .footer__mark {
    margin-top: clamp(56px, 8vw, 120px);
    container-type: inline-size;
  }

  .footer__wordmark {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    font-size: var(--fs-wordmark);
    font-size: calc(100cqi / var(--wordmark-ratio));
    line-height: 0.8;
    letter-spacing: -0.016em;
    text-transform: uppercase;
    color: var(--color-parchment);
    white-space: nowrap;
    text-align: center;
  }

  .footer__wordmark .split-line {
    padding-top: 0.06em;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid var(--color-graphite);
    color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/** Marqueur visible d'une information à fournir avant publication. */
interface Props {
  note?: string;
}
const { note } = Astro.props;
---

<mark class="todo">[À CONFIRMER AVANT PUBLICATION]{note && ` ${note}`}</mark>

<style>
  .todo {
    padding: 1px 6px;
    border: 1px dashed currentColor;
    border-radius: var(--radius-tags);
    background: transparent;
    color: var(--accent);
    font-size: 0.92em;
  }
</style>

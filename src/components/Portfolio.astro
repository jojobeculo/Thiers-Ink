---
import { getImage } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import SplitHeading from './SplitHeading.astro';
import MaskedImage from './MaskedImage.astro';
import ExternalIcon from './ExternalIcon.astro';
import { works, hasProvisionalWorks } from '../data/portfolio';
import { site } from '../config/site';

const sizesBySpan: Record<string, string> = {
  a: '(min-width: 900px) 40vw, 100vw',
  b: '(min-width: 900px) 32vw, 100vw',
  c: '(min-width: 900px) 32vw, 100vw',
  d: '(min-width: 900px) 50vw, 100vw',
  e: '(min-width: 900px) 32vw, 100vw',
  f: '(min-width: 900px) 25vw, 100vw',
  g: '(min-width: 900px) 34vw, 100vw',
};

// Données de la vue détaillée (images grand format générées au build).
const lightboxData = await Promise.all(
  works.map(async (work) => {
    const widths = [800, 1200, 1600].filter((w) => w <= Math.max(work.image.width, work.image.height));
    const [avif, webp] = await Promise.all(
      (['avif', 'webp'] as const).map((format) => getImage({ src: work.image, widths, format, quality: 76 })),
    );
    return {
      avif: avif.srcSet.attribute,
      webp: webp.srcSet.attribute,
      src: webp.src,
      width: work.image.width,
      height: work.image.height,
      alt: work.alt,
      title: work.title,
      details: work.details.join(' · '),
      provisional: work.provisional,
    };
  }),
);
---

<section class="portfolio section grain" id="portfolio" data-surface="dark" aria-labelledby="portfolio-title">
  <div class="container">
    <SectionHeader index="02" label="Portfolio" aside={hasProvisionalWorks ? 'Visuels provisoires' : undefined} />

    <div class="portfolio__head">
      <SplitHeading id="portfolio-title" class="t-display" lines={['Portfolio']} />
      {
        hasProvisionalWorks && (
          <p class="portfolio__notice" data-reveal="fade">
            La sélection des réalisations de l'atelier est en cours de constitution : les visuels ci-dessous sont des
            illustrations provisoires, pas des tatouages réalisés par le salon. Les créations récentes sont publiées sur{' '}
            <a class="link" href={site.social.instagram.url} target="_blank" rel="noopener noreferrer">
              Instagram<span class="sr-only"> (nouvel onglet)</span>
              <ExternalIcon />
            </a>
            .
          </p>
        )
      }
    </div>

    <ol class="works" role="list">
      {
        works.map((work, i) => (
          <li class:list={['work', `work--${work.span}`]}>
            <figure>
              <button
                class="work__open"
                type="button"
                data-work-index={i}
                data-cursor="view"
                aria-haspopup="dialog"
                aria-controls="lightbox"
              >
                <span class="sr-only">Agrandir : {work.title}</span>
                <MaskedImage
                  src={work.image}
                  alt={work.alt}
                  sizes={sizesBySpan[work.span]}
                  provisional={work.provisional}
                  parallax={0.04 + (i % 3) * 0.02}
                  class="work__frame"
                />
              </button>
              <figcaption class="work__caption t-caption">
                <span class="work__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="work__title">{work.title}</span>
                {work.details.length > 0 && <span class="work__details">{work.details.join(' · ')}</span>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </div>

  <dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-title" data-lightbox data-surface="dark">
    <div class="lightbox__bar">
      <p class="t-caption" aria-live="polite"><span data-lb-counter></span></p>
      <button class="lightbox__close t-ui" type="button" data-lb-close>
        Fermer
        <svg viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M2 2l10 10M12 2L2 12"></path>
        </svg>
      </button>
    </div>
    <figure class="lightbox__figure">
      <div class="lightbox__stage" data-lb-stage>
        <picture>
          <source type="image/avif" data-lb-avif />
          <source type="image/webp" data-lb-webp />
          <img data-lb-img alt="" sizes="(min-width: 1000px) 70vw, 92vw" decoding="async" />
        </picture>
        <p class="lightbox__error t-caption" data-lb-error hidden>Image indisponible.</p>
      </div>
      <figcaption class="lightbox__caption">
        <h2 class="t-subheading" id="lightbox-title" data-lb-title></h2>
        <p class="t-caption t-muted" data-lb-details></p>
        <span class="tag tag--provisional" data-lb-provisional hidden>Visuel provisoire</span>
      </figcaption>
    </figure>
    <div class="lightbox__nav">
      <button class="lightbox__arrow" type="button" data-lb-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M20 12H5M11 6l-6 6 6 6"></path></svg>
        <span class="sr-only">Visuel précédent</span>
      </button>
      <button class="lightbox__arrow" type="button" data-lb-next>
        <span class="sr-only">Visuel suivant</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
      </button>
    </div>
  </dialog>
  <script type="application/json" id="works-data" set:html={JSON.stringify(lightboxData)} />
</section>

<script>
  import '../scripts/portfolio';
</script>

<style>
  .portfolio {
    position: relative;
    z-index: 1;
  }

  .portfolio__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(48px, 7vw, 112px);
  }

  .portfolio__head :global(h2) {
    grid-column: 1 / span 7;
  }

  .portfolio__notice {
    grid-column: 9 / -1;
    color: var(--fg-muted);
    max-width: 44ch;
  }

  .works {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2.4vw, 40px);
    row-gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .work figure {
    display: grid;
    gap: 12px;
  }

  .work__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    perspective: 1200px;
  }

  .work__open :global(.work__frame) {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.7s var(--ease-out-expo);
  }

  .work__open :global(img) {
    transition: transform 1.1s var(--ease-out-expo), filter 0.6s var(--ease-editorial);
    filter: saturate(0.9) brightness(0.92);
  }

  .work__open:hover :global(img),
  .work__open:focus-visible :global(img) {
    transform: scale(1.045);
    filter: none;
  }

  .work__open:focus-visible {
    outline-offset: 6px;
  }

  .work__caption {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
  }

  .work__num {
    color: var(--accent);
  }

  .work__details {
    color: var(--fg-muted);
  }

  .work--a { grid-column: 1 / span 5; }
  .work--a :global(.work__frame) { aspect-ratio: 4 / 5; }
  .work--b { grid-column: 7 / span 4; margin-top: clamp(80px, 16vw, 260px); }
  .work--b :global(.work__frame) { aspect-ratio: 4 / 5; }
  .work--c { grid-column: 2 / span 4; }
  .work--c :global(.work__frame) { aspect-ratio: 1; }
  .work--d { grid-column: 7 / span 6; margin-top: clamp(40px, 8vw, 140px); }
  .work--d :global(.work__frame) { aspect-ratio: 3 / 2; }
  .work--e { grid-column: 1 / span 4; }
  .work--e :global(.work__frame) { aspect-ratio: 3 / 4; }
  .work--f { grid-column: 6 / span 3; margin-top: clamp(60px, 12vw, 200px); }
  .work--f :global(.work__frame) { aspect-ratio: 4 / 5; }
  .work--g { grid-column: 9 / span 4; margin-top: clamp(20px, 4vw, 60px); }
  .work--g :global(.work__frame) { aspect-ratio: 3 / 4; }

  @media (max-width: 900px) {
    .portfolio__head :global(h2),
    .portfolio__notice {
      grid-column: 1 / -1;
    }
    .works {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .work {
      grid-column: auto !important;
      margin-top: 0 !important;
    }
    .work--a,
    .work--d {
      grid-column: 1 / -1 !important;
    }
  }

  @media (max-width: 560px) {
    .works {
      grid-template-columns: 1fr;
    }
    .work {
      grid-column: 1 / -1 !important;
    }
  }

  /* Vue détaillée ---------------------------------------------------------- */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) var(--gutter);
    border: 0;
    background: color-mix(in srgb, var(--color-soot) 97%, transparent);
    color: var(--color-parchment);
    display: none;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    animation: lb-in 0.5s var(--ease-out-expo) both;
  }

  .lightbox::backdrop {
    background: rgb(16 15 14 / 0.6);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  .lightbox__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-graphite);
  }

  .lightbox__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    background: none;
    border: 0;
  }

  .lightbox__close svg {
    width: 14px;
    height: 14px;
  }

  .lightbox__figure {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: clamp(16px, 3vw, 48px);
    align-items: end;
    padding-block: clamp(16px, 3vh, 32px);
  }

  .lightbox__stage {
    position: relative;
    height: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
    touch-action: pan-y;
  }

  .lightbox__stage picture {
    display: contents;
  }

  .lightbox__stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition:
      opacity 0.45s var(--ease-editorial),
      transform 0.6s var(--ease-out-expo);
  }

  .lightbox__stage[data-state='out'] img {
    opacity: 0;
    transform: translate3d(calc(var(--dir, 1) * -24px), 0, 0);
  }

  .lightbox__stage[data-state='in'] img {
    opacity: 0;
    transform: translate3d(calc(var(--dir, 1) * 24px), 0, 0);
    transition: none;
  }

  .lightbox__error {
    position: absolute;
  }

  .lightbox__caption {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding-bottom: 8px;
  }

  .lightbox__nav {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  .lightbox__arrow {
    width: 56px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-walnut);
    border-radius: var(--radius-buttons);
    background: none;
    transition:
      background-color var(--dur-base) var(--ease-editorial),
      color var(--dur-base) var(--ease-editorial);
  }

  .lightbox__arrow svg {
    width: 22px;
    height: 22px;
  }

  .lightbox__arrow:hover {
    background: var(--color-parchment);
    color: var(--color-soot);
  }

  @media (max-width: 760px) {
    .lightbox__figure {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }
  }
</style>

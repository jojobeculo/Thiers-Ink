---
import { site } from '../config/site';

interface Props {
  class?: string;
  /** Affiche le numéro dans le libellé (sinon « Appeler le salon »). */
  withNumber?: boolean;
}

const { class: className, withNumber = true } = Astro.props;
---

<a class:list={['btn', 'btn--call', className]} href={site.phone.href} data-cursor="link">
  <svg class="btn__phone" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
    <path d="M5.2 1.8 3 2.2C2.4 2.3 2 2.8 2 3.4c.3 6 4.6 10.3 10.6 10.6.6 0 1.1-.4 1.2-1l.4-2.2-3-1.3-1.4 1.6a8.6 8.6 0 0 1-4.9-4.9l1.6-1.4-1.3-3Z"></path>
  </svg>
  <span>{withNumber ? `Appeler le ${site.phone.display}` : 'Appeler le salon'}</span>
</a>

<style>
  .btn--call {
    gap: 12px;
  }

  .btn__phone {
    width: 15px;
    height: 15px;
    flex: none;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .btn--call:hover .btn__phone {
    transform: rotate(-12deg) scale(1.1);
  }
</style>

---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site, withBase } from '../config/site';
import { MOTION_TIER_SCRIPT } from '../scripts/motion-tier.inline.mjs';
import { businessJsonLd, websiteJsonLd } from '../lib/seo';
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from 'astro:env/client';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Cursor from '../components/Cursor.astro';

interface Props {
  title: string;
  description?: string;
  /** Pages à ne pas indexer (confirmation d'envoi, 404). */
  noindex?: boolean;
  /** Données structurées Schema.org propres à la page (ajoutées au salon et au site). */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, jsonLd = [] } = Astro.props;
const structuredData = noindex
  ? undefined
  : { '@context': 'https://schema.org', '@graph': [businessJsonLd(Astro.site), websiteJsonLd(Astro.site), ...jsonLd] };

// Sans domaine définitif (SITE_URL), aucune URL absolue n'est inventée.
// Au build (format « file »), les chemins finissent par .html : on publie l'URL propre.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = Astro.site && !noindex ? new URL(cleanPath, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(withBase('/og-thiersink.jpg'), Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr" data-surface="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#100f0e" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    {PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    <meta name="geo.region" content="FR-63" />
    <meta name="geo.placename" content={site.address.city} />
    <meta name="geo.position" content={`${site.address.geo.lat};${site.address.geo.lng}`} />
    <meta name="ICBM" content={`${site.address.geo.lat}, ${site.address.geo.lng}`} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`${site.name}, ${site.activity.toLowerCase()} à ${site.address.city}`} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-satoshi" preload={[{ weight: 500, style: 'normal' }]} />
    <Font cssVariable="--font-cormorant" preload={[{ weight: 300, style: 'normal' }]} />

    <!-- Niveau de mouvement décidé avant le premier rendu (voir motion-tier.inline.mjs). -->
    <script is:inline set:html={MOTION_TIER_SCRIPT} />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <ConsentBanner />
    <SiteHeader />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <Cursor />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>

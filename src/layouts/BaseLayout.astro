---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../config/site';
import { MOTION_TIER_SCRIPT } from '../scripts/motion-tier.inline.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Cursor from '../components/Cursor.astro';

interface Props {
  title: string;
  description?: string;
  /** Pages à ne pas indexer (confirmation d'envoi, 404). */
  noindex?: boolean;
  /** Données structurées Schema.org propres à la page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, noindex = false, jsonLd } = Astro.props;

// Sans domaine définitif (SITE_URL), aucune URL absolue n'est inventée.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og-thiersink.jpg', Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr" data-surface="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#100f0e" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`${site.name}, ${site.activity.toLowerCase()} à ${site.address.city}`} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-satoshi" preload={[{ weight: 500, style: 'normal' }]} />
    <Font cssVariable="--font-cormorant" preload={[{ weight: 300, style: 'normal' }]} />

    <!-- Niveau de mouvement décidé avant le premier rendu (voir motion-tier.inline.mjs). -->
    <script is:inline set:html={MOTION_TIER_SCRIPT} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <ConsentBanner />
    <SiteHeader />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <Cursor />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>

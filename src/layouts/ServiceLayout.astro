---
/**
 * Page de prestation (référencement local : « tatouage Thiers », « piercing Thiers »).
 * Contenu factuel : déroulé d'une demande, conseils de préparation génériques,
 * accès au salon. Aucune politique tarifaire ni sanitaire n'est affirmée.
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SplitHeading from '../components/SplitHeading.astro';
import MaskedImage from '../components/MaskedImage.astro';
import BookingButton from '../components/BookingButton.astro';
import CallButton from '../components/CallButton.astro';
import CtaBand from '../components/CtaBand.astro';
import ExternalIcon from '../components/ExternalIcon.astro';
import { site, withBase, mapLinks } from '../config/site';
import { faq } from '../data/faq';
import { breadcrumbJsonLd, faqJsonLd, serviceJsonLd } from '../lib/seo';

interface Step {
  title: string;
  text: string;
}

interface Props {
  path: string;
  /** Libellé affiché (fil d'Ariane, bandeau) : « Tatoueur », « Piercing ». */
  name: string;
  /** Type de prestation déclaré dans les données structurées. */
  serviceType?: string;
  aboutHeading: string[];
  about: string[];
  title: string;
  description: string;
  heading: string[];
  lead: string;
  items: string[];
  steps: Step[];
  tips: Step[];
  faqIds: string[];
  image: ImageMetadata;
  imageAlt: string;
  related: { label: string; path: string };
}

const {
  path,
  name,
  serviceType = name,
  aboutHeading,
  about,
  title,
  description,
  heading,
  lead,
  items,
  steps,
  tips,
  faqIds,
  image,
  imageAlt,
  related,
} = Astro.props;
const questions = faq.filter((f) => faqIds.includes(f.id) && !f.draft);
const jsonLd = [
  serviceJsonLd(serviceType, description, path, Astro.site),
  breadcrumbJsonLd(
    [
      { name: 'Accueil', path: '/' },
      { name: `${name} à ${site.address.city}`, path },
    ],
    Astro.site,
  ),
  ...(questions.length ? [faqJsonLd(questions)] : []),
];
const towns = site.areaServed.filter((t) => t !== site.address.city && t !== site.address.region);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="svc">
    <header class="svc__head grain" id="top" data-surface="dark">
      <div class="container svc__head-grid">
        <nav class="t-caption svc__crumb" aria-label="Fil d'Ariane">
          <a class="link link--quiet" href={withBase('/')}>Accueil</a> / <span aria-current="page">{name} à {site.address.city}</span>
        </nav>
        <SplitHeading as="h1" class="t-display svc__title" lines={heading} />
        <div class="svc__lead">
          <p class="t-body-lg" data-reveal="fade">{lead}</p>
          <ul class="svc__items" role="list" data-reveal="fade" style="--i:1">
            {items.map((item) => <li class="tag">{item}</li>)}
          </ul>
          <div class="svc__actions" data-reveal="fade" style="--i:2">
            <BookingButton size="lg" />
            <CallButton />
          </div>
        </div>
        <MaskedImage
          src={image}
          alt={imageAlt}
          sizes="(min-width: 900px) 40vw, 100vw"
          provisional
          class="svc__image"
          loading="eager"
        />
      </div>
    </header>

    <section class="section svc__steps" data-surface="light" data-plane aria-labelledby="a-propos">
      <div class="container">
        <div class="svc__about">
          <SplitHeading id="a-propos" class="t-heading-lg" lines={aboutHeading} />
          <div class="prose svc__about-text">
            {about.map((p, i) => <p class={i === 0 ? 't-body-lg' : ''} data-reveal="fade" style={`--i:${i}`}>{p}</p>)}
            <div class="svc__actions" data-reveal="fade" style="--i:2">
              <BookingButton />
              <CallButton withNumber={false} />
            </div>
          </div>
        </div>
        <SplitHeading id="etapes" class="t-heading-lg" lines={['Comment se passe', 'une demande ?']} />
        <ol class="steps" role="list">
          {
            steps.map((step, i) => (
              <li class="step" data-reveal="fade" style={`--i:${i}`}>
                <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section svc__tips grain" data-surface="charcoal" aria-labelledby="preparer">
      <div class="container svc__tips-grid">
        <SplitHeading id="preparer" class="t-heading-lg" lines={['Préparer', 'votre projet']} />
        <dl class="tips">
          {
            tips.map((tip, i) => (
              <div data-reveal="fade" style={`--i:${i}`}>
                <dt>{tip.title}</dt>
                <dd>{tip.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section svc__visit" data-surface="light" data-plane aria-labelledby="venir">
      <div class="container svc__visit-grid">
        <div>
          <SplitHeading id="venir" class="t-heading-lg" lines={['Venir au salon', `à ${site.address.city}`]} />
          <p class="t-body-lg svc__visit-text" data-reveal="fade">
            {site.name} se trouve au {site.address.street}, {site.address.postalCode} {site.address.city}. Le salon accueille
            les personnes de {site.address.city} et des communes voisines : {towns.join(', ')}.
          </p>
        </div>
        <dl class="svc__facts" data-reveal="fade" style="--i:1">
          <div>
            <dt class="t-caption">Adresse</dt>
            <dd>
              {site.address.street}, {site.address.postalCode} {site.address.city}
              <a class="link t-caption svc__route" href={mapLinks.google} target="_blank" rel="noopener noreferrer">
                Itinéraire<span class="sr-only"> (Google Maps, nouvel onglet)</span><ExternalIcon />
              </a>
            </dd>
          </div>
          <div>
            <dt class="t-caption">Horaires</dt>
            <dd>
              {site.hours.map((h) => (
                <span class="svc__hour">
                  {h.days} : {h.hours}
                </span>
              ))}
              <span class="t-muted svc__note">Horaires indicatifs : un appel permet de confirmer.</span>
            </dd>
          </div>
          <div>
            <dt class="t-caption">Téléphone</dt>
            <dd><a class="link" href={site.phone.href}>{site.phone.display}</a></dd>
          </div>
        </dl>
      </div>
    </section>

    {
      questions.length > 0 && (
        <section class="section svc__faq" data-surface="dark" aria-labelledby="questions">
          <div class="container">
            <SplitHeading id="questions" class="t-heading-lg" lines={['Questions', 'fréquentes']} />
            <div class="svc__faq-list">
              {questions.map((q) => (
                <details class="svc__q" data-reveal="fade">
                  <summary>{q.question}</summary>
                  <p set:html={q.answer} />
                </details>
              ))}
            </div>
            <p class="svc__related" data-reveal="fade">
              Voir aussi : <a class="link" href={withBase(related.path)}>{related.label}</a> ·{' '}
              <a class="link" href={withBase('/#portfolio')}>le portfolio</a>
            </p>
          </div>
        </section>
      )
    }

    <CtaBand
      id="cta-service"
      kicker={`${name} à ${site.address.city}`}
      lines={['Prendre', 'rendez-vous']}
      text="Décrivez votre projet dans le formulaire ou appelez directement le salon."
    />
  </article>
</BaseLayout>

<style>
  .svc__head {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(32px, 4vw, 64px));
    padding-bottom: var(--section-space);
  }

  .svc__head-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px) var(--gap);
    align-items: end;
  }

  .svc__crumb {
    grid-column: 1 / -1;
    color: var(--fg-muted);
  }

  .svc__head-grid :global(.svc__title) {
    grid-column: 1 / span 7;
  }

  .svc__lead {
    grid-column: 1 / span 6;
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .svc__items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .svc__head-grid :global(.svc__image) {
    grid-column: 8 / -1;
    grid-row: 2 / span 2;
    aspect-ratio: 1;
    align-self: end;
  }

  .svc__about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px var(--gap);
    margin-bottom: var(--section-space);
  }

  .svc__about > :global(h2) {
    grid-column: 1 / span 5;
  }

  .svc__about-text {
    grid-column: 7 / -1;
    display: grid;
    gap: 18px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--gap);
    margin-top: clamp(40px, 5vw, 72px);
  }

  .step {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 28px;
    border-top: 1px solid var(--rule-strong);
  }

  .step__num {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-light);
    font-size: var(--fs-heading-sm);
    line-height: 1;
    color: var(--accent);
  }

  .step__title {
    font-size: var(--fs-body-lg);
    line-height: var(--leading-body-lg);
  }

  .step__text {
    color: var(--fg-muted);
  }

  .svc__tips-grid,
  .svc__visit-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) var(--gap);
    align-items: start;
  }

  .svc__tips-grid > :global(h2),
  .svc__visit-grid > div {
    grid-column: 1 / span 5;
  }

  .tips,
  .svc__facts {
    grid-column: 7 / -1;
  }

  .tips > div {
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }

  .tips dt {
    font-size: var(--fs-body-lg);
    margin-bottom: 8px;
  }

  .tips dd,
  .svc__facts dd {
    margin: 0;
    color: var(--fg-muted);
  }

  .svc__visit-text {
    margin-top: 24px;
  }

  .svc__facts > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 12px;
    padding-block: 16px;
    border-top: 1px solid var(--rule);
  }

  .svc__facts dd {
    color: var(--fg);
    display: grid;
    gap: 4px;
  }

  .svc__route {
    justify-self: start;
  }

  .svc__note {
    font-size: 13px;
  }

  .svc__faq-list {
    margin-top: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--rule);
  }

  .svc__q {
    border-bottom: 1px solid var(--rule);
  }

  .svc__q summary {
    padding-block: 20px;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    cursor: pointer;
  }

  .svc__q p {
    padding-bottom: 20px;
    color: var(--fg-muted);
    max-width: 62ch;
  }

  .svc__q :global(a) {
    color: var(--fg);
  }

  .svc__related {
    margin-top: 28px;
    color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    .svc__head-grid :global(.svc__title),
    .svc__lead,
    .svc__head-grid :global(.svc__image),
    .svc__tips-grid > :global(h2),
    .svc__about > :global(h2),
    .svc__about-text,
    .svc__visit-grid > div,
    .tips,
    .svc__facts {
      grid-column: 1 / -1;
    }
    .svc__head-grid :global(.svc__image) {
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 480px) {
    .svc__facts > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
